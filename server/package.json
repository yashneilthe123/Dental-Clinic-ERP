{
  "name": "dental-erp-server",
  "version": "1.0.0",
  "description": "Dental Clinic ERP - REST API (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node db/migrate.js",
